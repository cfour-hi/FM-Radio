{
  "name": "fm-radio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "map:stations": "node scripts/build-stations.mjs",
    "data:release": "node scripts/build-stations.mjs && pnpm build",
    "data:check": "node scripts/check-streams.mjs",
    "data:validate": "node scripts/validate-snapshot.mjs",
    "map:places": "node scripts/build-cn-places.mjs",
    "map:land": "node scripts/build-land-shape.mjs",
    "map:dots": "node scripts/build-land-dots.mjs",
    "map:dots:globe": "node scripts/build-land-dots.mjs --sphere",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
